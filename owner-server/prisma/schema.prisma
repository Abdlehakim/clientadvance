generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  employe
}

enum NotificationType {
  email
  whatsapp
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum LicenseStatus {
  active
  expired
  revoked
  suspended
}

enum CompanyStatus {
  active
  suspended
  archived
}

model Company {
  id           String        @id @default(cuid())
  name         String
  contactEmail String        @map("contact_email")
  contactPhone String?       @map("contact_phone")
  notes        String?
  status       CompanyStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  users        User[]
  licenses     License[]

  @@index([status])
  @@map("companies")
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String         @map("password_hash")
  role           Role
  isActive       Boolean        @default(true) @map("is_active")
  companyId      String?        @map("company_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  clientsCreated Client[]       @relation("ClientCreatedBy")
  clientsUpdated Client[]       @relation("ClientUpdatedBy")
  payments       Payment[]      @relation("PaymentCreatedBy")
  settings       AdminSettings[] @relation("SettingsUpdatedBy")
  activityLogs   ActivityLog[]
  syncStates     SyncState[]

  @@index([companyId])
  @@map("users")
}

/// TODO: Add company_id for full tenant isolation once client ownership is migrated.
model Client {
  id              String    @id
  nomComplet      String    @map("nom_complet")
  telephone       String?
  adresse         String?
  email           String?
  cin             String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  remoteUpdatedAt DateTime  @default(now()) @map("remote_updated_at")
  creator         User?     @relation("ClientCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater         User?     @relation("ClientUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  payments        Payment[]

  @@index([updatedAt])
  @@index([remoteUpdatedAt])
  @@map("clients")
}

/// TODO: Add company_id for full tenant isolation once payment ownership is migrated.
model Payment {
  id              String    @id
  clientId        String    @map("client_id")
  montant         Decimal   @db.Decimal(12, 3)
  datePaiement    String    @map("date_paiement")
  heurePaiement   String    @map("heure_paiement")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  remoteUpdatedAt DateTime  @default(now()) @map("remote_updated_at")
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  creator         User?     @relation("PaymentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  notifications   NotificationQueue[]

  @@index([clientId])
  @@index([remoteUpdatedAt])
  @@map("payments")
}

/// TODO: Add company_id for full tenant isolation once admin settings are tenant-scoped.
model AdminSettings {
  id              String   @id
  adminEmail      String?  @map("admin_email")
  adminWhatsapp   String?  @map("admin_whatsapp")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")
  remoteUpdatedAt DateTime @default(now()) @map("remote_updated_at")
  updater         User?    @relation("SettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("admin_settings")
}

/// TODO: Add company_id for full tenant isolation once activity logs are tenant-scoped.
model ActivityLog {
  id          String   @id
  userId      String?  @map("user_id")
  userName    String   @map("user_name")
  actionType  String   @map("action_type")
  description String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("activity_logs")
}

/// TODO: Add company_id for full tenant isolation once notification ownership is migrated.
model NotificationQueue {
  id           String             @id
  type         NotificationType
  recipient    String
  subject      String?
  body         String
  paymentId    String?            @map("payment_id")
  status       NotificationStatus @default(pending)
  errorMessage String?            @map("error_message")
  createdAt    DateTime           @default(now()) @map("created_at")
  sentAt       DateTime?          @map("sent_at")
  payment      Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("notification_queue")
}

model SyncState {
  id         String   @id
  userId     String   @map("user_id")
  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sync_state")
}

model License {
  id             String        @id @default(cuid())
  companyId      String?       @map("company_id")
  licenseKeyHash String        @unique @map("license_key_hash")
  customerName   String?       @map("customer_name")
  status         LicenseStatus @default(active)
  expiresAt      DateTime?     @map("expires_at")
  maxDevices     Int           @default(1) @map("max_devices")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  revokedAt      DateTime?     @map("revoked_at")
  suspendedAt    DateTime?     @map("suspended_at")
  note           String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  activations    LicenseActivation[]

  @@index([status])
  @@index([companyId])
  @@map("licenses")
}

model LicenseActivation {
  id            String    @id @default(cuid())
  licenseId     String    @map("license_id")
  deviceId      String    @map("device_id")
  appVersion    String?   @map("app_version")
  activatedAt   DateTime  @default(now()) @map("activated_at")
  lastCheckedAt DateTime? @map("last_checked_at")
  deactivatedAt DateTime? @map("deactivated_at")
  revokedAt     DateTime? @map("revoked_at")
  license       License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, deviceId])
  @@index([licenseId])
  @@map("license_activations")
}
